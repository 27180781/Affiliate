# ============================================================================
#  Clicker Affiliate — environment variables
#  Copy to .env for local dev, or set these in the CapRover app config.
# ============================================================================

# --- Server -----------------------------------------------------------------
NODE_ENV=production
PORT=4000

# --- Database ---------------------------------------------------------------
# Either a single URL …
# DATABASE_URL=postgres://user:pass@host:5432/affiliate
# … or discrete parts:
PGHOST=srv-captain--affiliate-db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=affiliate
# Set true when the DB requires TLS (most managed Postgres providers).
PGSSL=false
# When PGSSL=true, the server verifies the DB certificate by default. Optionally
# pin the provider CA (PEM contents), or (NOT recommended) skip verification.
# PGSSL_CA=-----BEGIN CERTIFICATE-----\n...
# PGSSL_NO_VERIFY=false

# --- Auth -------------------------------------------------------------------
# REQUIRED in every environment — the server refuses to start without it.
# Long random string. Generate with:  openssl rand -hex 32
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Payment webhook --------------------------------------------------------
# REQUIRED. pay.clicker.co.il must send this exact value in the
# `x-webhook-secret` header. Generate with:  openssl rand -hex 32
WEBHOOK_SECRET=please-change-me-too

# Local dev ONLY: allow weak built-in fallbacks if JWT_SECRET/WEBHOOK_SECRET
# are unset. Leave false everywhere except a throwaway local machine.
ALLOW_INSECURE_DEV_SECRETS=false

# --- Admin provisioning (run `npm run create-admin`) ------------------------
# ADMIN_EMAIL=you@clicker.co.il
# ADMIN_PASSWORD=a-strong-password
# ADMIN_NAME=Administrator

# --- Business rules ---------------------------------------------------------
# Bootstrap fallback only. The live default commission rate and cookie-retention
# days are stored in the `settings` table and edited from the admin dashboard.
# 0.20 = 20% commission on each purchase_amount.
COMMISSION_RATE=0.20

# Root domain used to build referral links & validate CORS for subdomains.
ROOT_DOMAIN=clicker.co.il

# Exact allowed origins for the dashboard/API (credentials-free, Bearer auth).
# The public /api/track-click beacon separately allows any *.ROOT_DOMAIN.
CORS_ORIGINS=https://affiliate.clicker.co.il

# Express `trust proxy`. LEAVE UNSET (recommended): the API then trusts only
# loopback + private/overlay proxy ranges and derives the real client IP from
# X-Forwarded-For correctly for BOTH the direct (1-hop) and dashboard-proxied
# (2-hop) paths, and it cannot be spoofed. Override only if you know your exact
# topology: an integer hop count, true/false, or a custom subnet list.
# TRUST_PROXY=

# Dedicated salt for hashing click IPs (defaults to JWT_SECRET if unset).
# IP_HASH_SALT=another-long-random-string

# Optional: pin the tracking-script click-beacon base URL. If unset it is
# derived from the (validated) request Host. Set this to your API's public URL
# to be explicit, e.g. https://affiliate.caprover.clicker.co.il
# PUBLIC_API_BASE=

# Optional: force-reset the auto-provisioned admin's password on boot. By
# default the admin is only CREATED if absent (existing password is preserved).
# ADMIN_FORCE_RESET=false

# --- Frontend (client build) ------------------------------------------------
# Base URL the React app calls. Used at build time by Vite.
VITE_API_URL=https://affiliate-api.clicker.co.il
