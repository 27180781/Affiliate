# nginx config for the affiliate dashboard SPA.
# The official nginx image runs envsubst over this template on startup, so
# ${API_UPSTREAM} is filled from the API_UPSTREAM env var (see Dockerfile).
server {
    listen       80;
    server_name  _;
    root   /usr/share/nginx/html;
    index  index.html;

    # Long cache for hashed assets.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # The tracking script is served dynamically by the API (so admins can change
    # cookie-retention days centrally). Proxy it to the API upstream, but fall
    # back to the baked-in static copy if the API is unreachable, so script
    # delivery — which is on every embedding site's critical path — survives API
    # downtime.
    location = /clicker-affiliate.js {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass http://$api_upstream/clicker-affiliate.js;
        proxy_set_header Host $host;
        proxy_intercept_errors on;
        proxy_connect_timeout 3s;
        error_page 502 503 504 =200 @static_script;
    }
    location @static_script {
        add_header Cache-Control "public, max-age=300";
        types { } default_type application/javascript;
        try_files /clicker-affiliate.js =404;
    }

    # Same-origin API proxy → the Express service. Keeps the dashboard free of
    # CORS and build-time API URLs. (Cross-subdomain click beacons still hit the
    # API directly and are handled by the API's own CORS rules.)
    #
    # Use the Docker embedded DNS resolver + a variable upstream so the hostname
    # is resolved per-request (at request time) rather than once at boot. This
    # lets nginx start even if the API app isn't up/resolvable yet (returns 502
    # per request instead of crash-looping the whole web container).
    location /api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass         http://$api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # SPA history-mode fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
