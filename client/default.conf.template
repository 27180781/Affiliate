# nginx config for the affiliate dashboard SPA.
# The official nginx image runs envsubst over this template on startup, so
# ${API_UPSTREAM} is filled from the API_UPSTREAM env var (see Dockerfile).
server {
    listen       80;
    server_name  _;
    root   /usr/share/nginx/html;
    index  index.html;

    # Long cache for hashed assets; the tracking script stays fresh-ish.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location = /clicker-affiliate.js {
        add_header Cache-Control "public, max-age=3600";
    }

    # Same-origin API proxy → the Express service. Keeps the dashboard free of
    # CORS and build-time API URLs. (Cross-subdomain click beacons still hit the
    # API directly and are handled by the API's own CORS rules.)
    location /api/ {
        proxy_pass         http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # SPA history-mode fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
